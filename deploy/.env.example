# 复制为同目录 .env 后再起栈:cp deploy/.env.example deploy/.env
# .env 已被根 .gitignore 忽略,凭证永不入库。
# 以下均为本地开发占位值,禁止用于任何真实环境。
# 值书写(两种消费路径,同一形态兼容):值含 () {} " , : 等特殊字符时(如 DSN
# 的 tcp(...)、JSON 单价表/白名单)必须加单引号——shell source 语义下裸括号/
# 花括号会解析报错并使后续行静默失效;compose ${VAR} 插值(compose-go dotenv)
# 会剥离单引号,两不误。
MYSQL_ROOT_PASSWORD=braid_dev_root

# ---- 共享基础设施(本地起进程时注入;compose 栈自身不消费)----
# MySQL DSN(api/relay/worker/reaper 共用;compose 栈 MySQL 在 3306,
# 账号密码见 dev.docker-compose.yml)。
# BRAID_MYSQL_DSN=
# 队列 Redis(relay/worker 共用;dev 栈 6379;reaper 可选 = leaderless)。
# BRAID_REDIS_QUEUE_ADDR=127.0.0.1:6379
# MySQL 连接池三值(T7.1,四入口共用;默认 25/25/5m,容量公式与配额表见
# deploy/README.md §1:Σ MAX_OPEN ≤ max_connections − 预留 30)。
# BRAID_DB_MAX_OPEN=25                # 单进程最大打开连接(≥1;软上限 100,
#                                    #  超限收敛 + 启动 warn,见 deploy/README.md §1)
# BRAID_DB_MAX_IDLE=25                # 空闲保留(0 ≤ idle ≤ open;低流量部署可调低)
# BRAID_DB_CONN_MAX_LIFETIME=5m       # 连接最长复用(>0;消化 wait_timeout/LB 轮转)

# ---- api(T5.4)----
# JWT 密钥无默认值,缺省启动即败:openssl rand -hex 32 生成。
# BRAID_AUTH_JWT_SECRET=
# BRAID_API_ADDR=127.0.0.1:8081
BRAID_API_SNOWFLAKE_NODE=1         # 三层解析(T15.2,D-t151 决策 2):数字 = 显式
#                                    #  claim(api 缺省 1、worker 缺省 2、reaper 缺省 3
#                                    #  ——T20.9 起由 auto 改 3);"auto" = 租约池分配
#                                    #  (k8s 多副本一律 auto;显式限单副本/compose;
#                                    #  relay 无生成器)。
#                                    #  **本栈必须显式**:dev-up.sh 先起 reaper;若让号走
#                                    #  池分配,租约表残留行(TTL 未过)会让 auto 线性取到
#                                    #  下一个空闲号 = api 的缺省号,api 随即「node lease
#                                    #  held by another holder」启动即退(空表首跑正常,
#                                    #  之后每次重启都挂;T20.9 前缺省正是 auto,空表取
#                                    #  node 0)。
#                                    #  与 prod.docker-compose.yml 同口径(api1/worker2/reaper3)。
# BRAID_API_RESUME_QUEUE=default     # 审批续跑事件(execution.resume)队列(T4.2);
#                                    #  必须在 BRAID_WORKER_QUEUES 内,否则 worker
#                                    #  启动即败(T12.2 交叉校验执法,原「永挂
#                                    #  pending」已知边界收口);独立队列是
#                                    #  「审批/续跑与重 LLM 任务隔离」的换装点
# http.Server 四超时(T7.1 收编,原 cmd 常量语义原样;攻击面口径见
# deploy/README.md §4——公开面部署不建议放宽):
# BRAID_API_READ_HEADER_TIMEOUT=10s  # slowloris 慢速头部硬上限
# BRAID_API_READ_TIMEOUT=60s         # 整请求读取(1MiB DSL 上限)
# BRAID_API_WRITE_TIMEOUT=30s        # 响应写出
# BRAID_API_IDLE_TIMEOUT=120s        # keep-alive 空闲连接
# 发布工具白名单已随 T3.2 换源到 tools.Registry 注册名(BRAID_TOOL_ALLOWLIST
# 退役;空 registry = 禁用一切工具,语义同原空名单)。内置工具 T3.5 注册。

# 登录防御(T6.4 落地,T11.3 起 DB 锚定 = login_throttle 表 0010:多副本
# 共享、重启不清零,D-t64「进程内存」边界已由 D-2026-09-29-t113 #2 消解)。
# BRAID_API_LOGIN_RATE=10            # 窗口内每 IP 登录尝试上限
# BRAID_API_LOGIN_WINDOW=1m          # 固定窗口宽(Go duration 形态,如 30s)
# BRAID_API_LOGIN_MAX_FAILURES=5     # 连败锁定阈值(username 维度)
# BRAID_API_LOGIN_LOCKOUT=15m        # 锁定时长(期满自愈,无显式解锁面)
# token 绑定(T11.3,D-t113 #1):off|ua|ua_ip24 闭集——off=零行为(缺省);
# 开启即全量换发语义:存量无 claim token 一律 401 token_binding_mismatch
# (存量损失 ≤ token TTL 24h,切换窗口自选)。ua_ip24 叠加 IP 前缀
# (v4 /24、v6 /64),网段内漂移不误杀。已知边界:不携 User-Agent 的
# 客户端绑定值为共享常量,该类客户端之间无重放防御。
# BRAID_API_TOKEN_BINDING=off        # ua = 绑 User-Agent;ua_ip24 = 再叠 IP 前缀
# 认证参数(T5.3 auth 包;未设取默认)——
# BRAID_AUTH_TOKEN_TTL=24h           # Bearer token 有效期((0, MaxTokenTTL])
# BRAID_AUTH_BCRYPT_COST=10          # 口令哈希成本([4,31];上界防误配 DoS,偏离
#                                    #  默认会部分重开未知用户枚举时序面,见
#                                    #  internal/auth/config.go 字段注释)

# ---- metrics(T6.4;worker/relay/reaper 独立 exposition 端口)----
# 空(缺省)= 不启;api 的 /metrics 恒挂 BRAID_API_ADDR 同端口(与 /healthz
# 同回环绑定)。compose 各容器独立网络命名空间,同端口不冲突。
# BRAID_METRICS_ADDR=127.0.0.1:9090
# 部署注记:api 公开面经反向代理时转发 /api/v1、SPA 面(根路径 /、/login、
# /workflows/*、/executions/*、/approvals/*)与 /assets/*;旧审批台/画布前缀
# 已下线(硬切 404,无重定向)。/metrics 与
# /healthz 留内网(无认证 exposition,回环约定的一部分)。反代部署必须
# 配 BRAID_API_TRUSTED_PROXIES(代理内网段 CIDR,逗号分隔)——否则全部
# 客户端折叠进代理单地址的同一登录限流窗口(平台级 DoS 面);仅内网
# 直连部署保持空(fail-closed)。
# BRAID_API_TRUSTED_PROXIES=172.17.0.2/32   # 只列反代自己的精确地址(/32),
#                                    #  段内每个地址都能借 X-Forwarded-For 设定
#                                    #  限流键——名单越窄越好

# ---- tools(T3.2;scoped token 签发密钥,worker 进程)----
# BRAID_TOOL_TOKEN_SECRET=          # hex(如 openssl rand -hex 32);缺省 = 进程内
#                                    #  随机(重启轮换,P0 同进程校验自洽;P1 工具
#                                    #  回调平台需跨进程校验时显式供给)

# ---- 内置工具(T3.5;api 与 worker 共用同一 env 单源装配)----
# http 端点白名单:JSON 对象 alias→https base URL(host 逐跳白名单即此表
# 宿主集;base 仅 scheme+host[:port],完整 path 每次调用经 DSL 声明)。
# 未设/空 → 不注册 http(定义引用它将在发布时被拒)。
# BRAID_HTTP_ENDPOINTS='{"docs_api":"https://docs.example.com"}'
# file_read 目录白名单:JSON 数组(绝对路径;符号链接逃逸与白名单外路径
# 均被拒)。未设/空 → 不注册 file_read。
# BRAID_FILEREAD_DIRS='["/var/braid/docs"]'
# 生产 Compose 的宿主来源目录(不传给进程)，只读挂为 /var/braid/docs。
# 未设时挂 deploy/tool-data 空目录；目录必须已存在，禁止自动创建。
# 白名单与 DSL path 填容器路径；文件须允许镜像 uid 65532 读取。
# BRAID_FILEREAD_HOST_DIR=/srv/braid/docs
# db_query 只读账号连接串(T10.4;参数化 SELECT-only,凭证仅经 env 注入,
# 不进代码/日志/审计;只读账号 GRANT SQL 与上限语义见 deploy/README.md §10)。
# 未设/空 → 不注册 db_query。沙箱模式下 DSN host:port 自动进 egress 钉死
# 条目(私网豁免,D-2026-09-30-t104-dbquery-egress)。
# BRAID_DBQUERY_DSN='ro:<随机口令>@tcp(db.internal:3306)/analytics'
# 外部 MCP server 声明(T13.2;静态声明工具集,无运行期动态发现——发布
# 白名单不受外部 server 状态影响)。SERVERS = JSON 对象 alias→https base
# URL(路径前缀允许,如 https://host/mcp);TOOLS = JSON 对象 注册名→
# {server, tool}(注册名词形 ^[a-z][a-z0-9_]{0,63}$,进 registry.Names()
# 发布白名单)。server 必须被至少一个工具引用(半配置启动即败)。
# MCP 工具与内置同权限模型(RBAC/token/审计同链);出网过守卫+egress
# 代理(沙箱 docker 模式下 host:port 自动进 Allow 集)。stdio 不支持。
# BRAID_MCP_SERVERS='{"weather":"https://mcp.example.com/mcp"}'
# BRAID_MCP_TOOLS='{"mcp_weather_lookup":{"server":"weather","tool":"lookup_weather"}}'
# per-server 静态 bearer(凭证仅经 env 注入,零回显;缺席 = 匿名连接)。
# BRAID_MCP_TOKEN_WEATHER=
# 工具沙箱(T10.1;容器级隔离,值域与配额口径见 deploy/README.md §7):
# 模式 off(未设/空 = 缺省,本地进程执行,零 docker 接触)| docker
# (http/file_read/db_query 迁容器;worker 启动 Probe 缺 bin/daemon/镜像即拒启)。
# BRAID_TOOL_SANDBOX=docker
# 沙箱镜像引用(缺省下行值;构建两步命令见 deploy/README.md §7)。
# BRAID_TOOL_SANDBOX_IMAGE=braid-tool-sandbox:1
# 资源档位基线提案值(生产终值 P1 评审定档;docker 旗标原样值域)。
# BRAID_TOOL_SANDBOX_MEMORY=256m
# BRAID_TOOL_SANDBOX_CPUS=0.5
# BRAID_TOOL_SANDBOX_PIDS=64          # 整数 1..4096
# BRAID_TOOL_SANDBOX_MAX_CONCURRENCY=8 # 并发容器上界 1..1000
# egress 默认拒绝代理(T10.2;docker 模式下 http 载体出网唯一通道,拓扑
# 契约与运维面见 deploy/README.md §9)。EGRESS_ADDR 是 worker 启动自算
# 自写的进程内传递键,不在此手配。
# BRAID_TOOL_SANDBOX_EGRESS_NETWORK=braid-sbx-egress  # 网名基段,≤55 字符;worker 启动自动追加实例段(T15.4)
# BRAID_TOOL_SANDBOX_EGRESS_PORT=9210  # 0 = 内核指派
# OWNER(T15.3)与 EGRESS_ADDR 同类:worker 启动从 WorkerID(BRAID_WORKER_ID
# 或 hostname 兜底)自写的进程内传递键,不在此手配——沙箱容器清扫按它
# 只清自家,手配异值会切断对账面(deploy/README.md §7.1)。
# 工具包签名(T10.3;api 与 worker 共用,语义矩阵与 openssl 命令见
# deploy/README.md §8)。整组缺省 = 签名未部署(上方内置工具 env 照常);
# BRAID_TOOL_SIGNING_PUBLIC_KEY 一旦在场即签名态:package+signature 必须
# 全配、验签必须通过、BRAID_HTTP_ENDPOINTS/BRAID_FILEREAD_DIRS 必须清空
# ——任一违反启动即败(fail closed,无降级开关)。三键均单行 base64。
# BRAID_TOOL_SIGNING_PUBLIC_KEY=   # 32B Ed25519 公钥(提取命令见 §8)
# BRAID_TOOL_PACKAGE=              # 清单 JSON 原始字节(base64)
# BRAID_TOOL_PACKAGE_SIGNATURE=    # 64B Ed25519 签名(base64;发布侧私钥
#                                    #  永不进本仓/日志/部署面)

# ---- relay(T2.2;全部可选,未设取 relay.DefaultConfig 默认)----
# BRAID_RELAY_IDLE_INTERVAL=1s       # 空转(无可投行)轮询 tick;有行时连续排空
# BRAID_RELAY_ENQUEUE_TIMEOUT=5s     # 单次入队预算(= 单行锁窗)
# BRAID_RELAY_MAX_ATTEMPTS=6         # 单事件投递尝试上限(耗尽转 DEAD 死信)
# BRAID_RELAY_BACKOFF_BASE=5s        # 指数退避基(第 n 次失败后 base×factor^(n-1))
# BRAID_RELAY_BACKOFF_FACTOR=4       # 退避因子(默认序列 5s→20s→80s→5m,约
#                                    #  11.8min 转 DEAD,对齐 T6.4 死信告警节奏)
# BRAID_RELAY_BACKOFF_MAX=5m         # 退避封顶

# ---- worker(T2.3;T3.6 起须同时供给 llm 组)----
BRAID_WORKER_SNOWFLAKE_NODE=2     # 显式配置面见 api 组注释
# BRAID_WORKER_CONCURRENCY=10
# BRAID_WORKER_QUEUES=default:1
# BRAID_WORKER_ID=                  # 空 → hostname
# BRAID_WORKER_HEARTBEAT_INTERVAL=10s
# BRAID_WORKER_RETRY_DELAY=5s
# BRAID_WORKER_SHUTDOWN_TIMEOUT=30s

# ---- llm(T3.1/T3.6;worker 生产装配必需,缺 URL/KEY/PRICE_TABLE 启动即败)----
# BRAID_LLM_BASE_URL=               # OpenAI 兼容端点根(含版本路径)
# BRAID_LLM_API_KEY=                # 仅经 env 注入,不进代码/日志/审计
# BRAID_LLM_PRICE_TABLE=            # JSON:模型单价与 fallback(见 internal/llm/cost.go;
#                                    #  值须整体加单引号,见文件头书写规则)
# BRAID_LLM_TIMEOUT=2m0s
# BRAID_LLM_MAX_ATTEMPTS=3          # 组合预算 ≤ llm 节点 deadline 30m(启动校验)
# BRAID_LLM_BACKOFF_BASE=1s
# BRAID_LLM_BACKOFF_FACTOR=2
# BRAID_LLM_BACKOFF_MAX=30s
# BRAID_LLM_TOKEN_BUDGET=0          # T18.2 每执行 token 预算闸(0=关,缺省;
#                                    #  判据 = Σ已计费 usage + 当次估算(prompt)
#                                    #  + max_tokens 完成预留(声明时计)超限
#                                    #  pre-call 拒,审计分面 llm.call.budget_denied;
#                                    #  上限 1e9)
# 生产 Compose 与 Helm(config.llmTokenBudget)均透传此值到 worker。

# ---- smtp(T4.5;审批超时升级通知,worker 进程)----
# 整组缺省(BRAID_SMTP_HOST 未设)= 未配置:worker 对 approval.notify 走降级
# log-only ack(dev 栈无 SMTP 可用);半配置(有 HOST 缺 FROM/NOTIFY_TO/
# APPROVAL_BASE_URL)启动即败。凭证仅经 env 注入,不进代码/日志/审计。
# BRAID_SMTP_HOST=                  # SMTP 服务器主机名
# BRAID_SMTP_PORT=587               # STARTTLS 惯例口;内网明文中继可改 25 并关 STARTTLS
# BRAID_SMTP_USERNAME=              # 空 = 不认证(内网开中继形态)
# BRAID_SMTP_PASSWORD=              # 仅经 env 注入;认证仅在 TLS 会话上发送
# BRAID_SMTP_FROM=braid@example.com
# BRAID_SMTP_NOTIFY_TO=ops@example.com,approval@example.com
#                                    # ops 副本/兜底收件邮箱(逗号分隔,可选;T12.2
#                                    # 扇出后不再是唯一收件面)。逐人收件 = DSL
#                                    # approvers × users.email(0009 列,回填走
#                                    # 运维 SQL);无邮箱 approver 名字留正文、由
#                                    # 本副本兜底。零可解析收件人(无 approver 有
#                                    # 邮箱且本键空)= 发送响亮失败归死信告警
# BRAID_SMTP_STARTTLS=true          # 显式供给才可关(默认开)
# BRAID_SMTP_CA_FILE=               # 私有 CA 中继的信任池 PEM 文件路径(T12.2,
#                                    #  D-t45 §7;文件不可读/PEM 空 = 启动即败;
#                                    #  未设 = 系统信任池)
# BRAID_SMTP_TIMEOUT=15s            # 单次发送全预算(≤2m)
# BRAID_APPROVAL_BASE_URL=https://braid.example.com
#                                    # 审批链接前缀;邮件链接 = 该值 +
#                                    # /executions/<id>/approvals/<node_id>

# ---- im(T14.3;钉钉审批卡片,worker 进程;D-2026-09-30-t143)----
# 与 SMTP 并列的第二通知通道(worker 扇出,per-channel 去重,互不遮蔽);
# 整组缺省(BRAID_IM_WEBHOOK_URL 未设)= 通道不装。BRAID_APPROVAL_BASE_URL
# 为 SMTP/IM 双通道共享键(上组):IM 配置时必设,卡片按钮短链 = 该值 +
# /api/v1/im/approval。半配置(WEBHOOK_URL 设而 LINK_SECRET 缺)启动即败。
# **单租户契约**:webhook 是部署级单键、无租户分流面——非平台租户
#  (tenant_id≠0)执行的审批升级将响亮拒发(worker 死信可见)。多租户
#  部署请勿启用本通道(per-tenant 路由归后续决策,D-t143 决策 6)。
# BRAID_IM_WEBHOOK_URL=             # 钉钉自定义群机器人 webhook
#                                    #  (https://oapi.dingtalk.com/robot/send?
#                                    #   access_token=…;access_token 是凭证,
#                                    #   不进代码/日志/审计)
# BRAID_IM_SECRET=                  # 钉钉加签密钥(SEC…;机器人安全模式为
#                                    #  关键词/IP 白名单时留空 = 请求不加签)
# BRAID_IM_LINK_SECRET=             # 卡片按钮鉴权短链 HMAC 密钥(≥32 字节,
#                                    #  openssl rand -hex 32 随机生成,勿用人记
#                                    #  口令——卡片链接是群内可见的签名样本,
#                                    #  弱密钥可被离线字典攻击后伪签任意投票;
#                                    #  **api 与 worker 双端同键同批供给**:
#                                    #  worker 签发卡片链接、api 验证落票——
#                                    #  单侧配置无法启动期检出,跨组件部署契约
#                                    #  D-t143 决策 7;worker 配了 api 没配 =
#                                    #  在野链接点击全 404,反之卡片发不出)
# BRAID_IM_TIMEOUT=10s              # 单次发送全预算(≤1m)

# ---- reaper(T2.5)----
# 全部可选(未设取 reaper.DefaultConfig 默认);BRAID_WORKER_* 同时设置时
# DEAD_GRACE 会做跨进程硬校验(grace ≤ retry+heartbeat 启动即败)。
# BRAID_REAPER_SCAN_INTERVAL=30s
# BRAID_REAPER_DEAD_GRACE=45s
# BRAID_REAPER_EXEC_STALE=2m         # 执行级静默窗(PENDING 判死 / RUNNING 终态
#                                    #  补判共用 last_activity_at 阈值)
# BRAID_REAPER_PENDING_TTL=30m       # PENDING 执行判死阈值(须 > relay 退避穷尽
#                                    #  ~11.8min,否则杀健康事件)
# BRAID_REAPER_DISPATCH_STALE=30m    # DISPATCHED 活窗(事件已投未生效的容忍上限,
#                                    #  超过视为死事件可重派)
# BRAID_REAPER_QUEUE=default         # 死信网重投 + approval.notify 事件队列;与
#                                    #  BRAID_API_RESUME_QUEUE 同受 worker 启动
#                                    #  交叉校验(不在 BRAID_WORKER_QUEUES 内即拒启,
#                                    #  T12.2;D-t43 §7 已知边界收口)
# BRAID_REAPER_ID=          # 空 → hostname
BRAID_REAPER_SNOWFLAKE_NODE=3      # 雪花节点号(T15.2;T20.9 起空 → 内建缺省 3——
#                                    #  与 api=1/worker=2 同形;PID 派生已退役,容器
#                                    #  PID 恒 1 撞 api 缺省 1;数字 = 显式 claim,
#                                    #  撞号症状 = 业务表 PK 1062)。多副本一律写
#                                    #  auto:见 api 组注释/k8s 永久僵局)
# BRAID_REAPER_AUDIT_RETENTION=2160h          # audit_log 分区保留期(≥24h;T6.1 配置化)
# BRAID_REAPER_LOGIN_AUDIT_RETENTION=2160h    # login_audit 批量清理保留期(≥24h;
#                                             #  T7.1 接线 janitor event_at DELETE)
# BRAID_REAPER_NODE_ATTEMPT_RETENTION=720h    # node_attempt 终态留档清理保留期
#                                             #  (≥24h;T18.6 容量定档 30d,RUNNING 永不删)
# BRAID_REAPER_AUDIT_FLUSH_INTERVAL=1s        # 暂存审计行搬运 tick(≥100ms;
#                                             # = 审计行可见性滞后上界,T6.1)
# BRAID_REAPER_AUDIT_FLUSH_BATCH=500          # 单批搬运行数上限 [1,2700](prepared
#                                             # 占位符预算 24/行;T6.1 起,T9.3 +hash、T11.2 +tenant)
# BRAID_REAPER_JANITOR_INTERVAL=1h            # 分区水位/outbox 清理作业节流间隔
# BRAID_REAPER_OUTBOX_BATCH=500               # outbox DISPATCHED 清理单批 DELETE 上限
# 注:audit_log 分区水位作业需要 DDL 权限——业务账号仅 INSERT/SELECT
# (0001 DDL 契约),reaper 账号需 ALTER(生产账号分离,T7.3 自检断言)。
# 注:audit_pending 暂存表(0004,T6.1):worker 持 INSERT(高频事件同事务
# 暂存;api 零触——api 审计走同步 Append 直写 audit_log),reaper 持
# SELECT+DELETE(读批搬运 + 核销)——表级最小授权部署时四入口 preflight
# 均不触及本表(append-only 断言面 = audit_log + login_audit,T7.4 扩面;
# reaper 对 login_audit 的表级 DELETE 是预配豁免,见 janitor 组注释)。reaper 停摆期间
# 审计行滞留暂存(不丢),可见性恢复以 reaper 起回为准。

# ---- oidc(T11.1;OIDC redirect 流登录,api 进程)----
# 整组缺省 = OIDC 关闭(路由不挂载,内置 login 不受影响);半配置(任一键
# 设而组不全)启动即败。discovery 启动期拉取——issuer 错/不可达即启动失败。
# 主体映射 = 本地账号锚定(D-2026-09-28-t111-oidc-subject-anchor):所选
# claim 值必须精确等于本地 users.username(过既有词域),角色/状态取本地库;
# 未匹配本地账号 → 401。凭证仅经 env 注入,不进代码/日志/审计。
# BRAID_OIDC_ISSUER=https://idp.example.com
#                                    # issuer URL,discovery 基址;http 仅回环豁免
# BRAID_OIDC_CLIENT_ID=braid
# BRAID_OIDC_CLIENT_SECRET=          # 仅经 env 注入;state cookie 签名密钥自
#                                    # 此 HKDF 派生(域分隔,不另设密钥)
# BRAID_OIDC_REDIRECT_URL=https://braid.example.com/api/v1/auth/oidc/callback
#                                    # 须与 IdP 注册的回调完全一致
# BRAID_OIDC_CLAIM=preferred_username
#                                    # 主体映射源:sub | preferred_username;
#                                    # 缺省 preferred_username;词表封闭
#                                    # (email 词源在本地锚定下结构性死路:
#                                    # RFC 5322 形态永不过本地词域,配置即
#                                    # 拒;email 锚定随 P1 映射表回归)

# ---- ldap(T17.6;LDAP bind 凭证核验登录,api 进程;企业增值面)----
# 整组缺省 = LDAP 关闭(内置口令登录不受影响);半配置(任一键设而必填
# 不全)启动即败。构造期启动探测——目录不可达/服务账号 bind 失败即启动
# 失败。形态 = search-then-bind:服务账号 bind → 按 filter 搜索单条目 →
# 用服务端返回的 DN bind 用户密码(零 DN 模板拼接,注入面结构性消亡)。
# 主体锚定 = 本地账号(D-t111 同则):搜索命中的 uid 必须精确等于本地
# users.username(过既有词域),角色/状态取本地库;未匹配 → 401(与
# 错密同形,防枚举)。服务凭据仅经 env 注入,不进代码/日志/审计(铁律);
# 登录审计归因词 = login_audit.method 'ldap'(0014,与 DDL ENUM 同步)。
# BRAID_LDAP_ADDR=ldaps://ldap.example.com:636
#                                    # ldap://(明文,STARTTLS 可选)|
#                                    # ldaps://(TLS 由方案承载);host 必填
# BRAID_LDAP_BIND_DN=cn=braid,ou=services,dc=example,dc=org
#                                    # 服务账号 DN(search 前 bind)
# BRAID_LDAP_BIND_PASSWORD=          # 仅经 env 注入
# BRAID_LDAP_BASE_DN=ou=people,dc=example,dc=org
#                                    # 用户条目搜索基
# BRAID_LDAP_FILTER=(uid=%s)
#                                    # 可选;恰一个 %s(违者启动即拒);
#                                    # 缺省 (uid=%s);代入值过 RFC 4515
#                                    # 转义 + username 词域前置门(双保险)
# BRAID_LDAP_STARTTLS=               # 可选 bool(1/t/true/0/f/false);
#                                    # 仅 ldap:// 有意义,ldaps:// 下矛盾即拒

# --- OpenTelemetry trace(T6.2;P1 = D-t121)---
# BRAID_TRACE_EXPORTER=off                   # off | stdout | jaeger(off = 丢弃导出器,
#                                            # trace id 仍生成并写 audit_log.trace_id,
#                                            # 审计链不随观测开关退化;jaeger = OTLP/HTTP
#                                            # 导出,Jaeger ≥1.35 原生收 OTLP)
# BRAID_TRACE_OTLP_ENDPOINT=http://localhost:4318
#                                            # jaeger 导出器目标(http://host:port;
#                                            # http scheme = insecure,https = TLS;
#                                            # 仅 jaeger 值生效,off/stdout 忽略)

# ---- 交付栈(prod.docker-compose.yml,T7.4)----
# 用法(一键):deploy/prod-up.sh —— 播种 deploy/prod.env(交付栈配置文件,
#   git-ignored,与 dev 的 deploy/.env 物理分离,root 密码互不波及)→ 密钥
#   生成/继承 → build → up -d → reaper audit-ready 健康闸。幂等,重跑安全。
# 手工等价:cp deploy/.env.example deploy/prod.env → 补齐下方键 →
#   docker compose --env-file deploy/prod.env -f deploy/prod.docker-compose.yml build && \
#   docker compose --env-file deploy/prod.env -f deploy/prod.docker-compose.yml up -d
# 组件业务键(JWT/LLM/SMTP/工具白名单)沿用上方各组件段同名 env,经 prod.env
# 注入;此处只列交付栈新增键。账号面 = deploy/README.md §5 按组件授权矩阵。
# 生产必改首行的 MYSQL_ROOT_PASSWORD(git 内已知占位值 braid_dev_root 不得
# 用于生产;openssl rand -hex 24 生成,prod-up.sh 对占位值自动轮换)——
# 交付栈不在此重复赋值,单源首键。
# 四组件 DB 账号密码(grants one-shot 于迁移后建账号;已有卷的升级/改密
# 路径见 UPGRADE.md §3;字符集限 [A-Za-z0-9._~@+%-],grants.sh 越界即拒):
# BRAID_DB_API_PASSWORD=
# BRAID_DB_WORKER_PASSWORD=
# BRAID_DB_RELAY_PASSWORD=
# BRAID_DB_REAPER_PASSWORD=

# T15.5 回滚容量闸:单次回滚允许锁定的 node_execution 行集上界(控制行+
# parallel 实例行)。缺省 = scheduler.DefaultMaxRollbackRows(压测定档);0 = 关闭。
# BRAID_ROLLBACK_MAX_ROWS=4000
